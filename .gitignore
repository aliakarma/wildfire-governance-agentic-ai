# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/

# Data: never commit raw or processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results: only paper/ is committed; runs/ and reproduced/ are gitignored
results/runs/*
!results/runs/.gitkeep
results/reproduced/

# Credentials and secrets: NEVER commit
.env
*.pem
*.key
*.p12
*.pfx
*_key.json
fabric-network/

# ML artefacts
mlruns/
wandb/
lightning_logs/
*.ckpt
*.pt
!src/wildfire_governance/rl/checkpoints/ppo_gomdp_best.pt
!src/wildfire_governance/rl/checkpoints/ppo_gomdp_final.pt

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDEs, AI assistants, and editor caches
.vscode/
.idea/
.cursor/
.claude/
.agents/
.gemini/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs build
site/
docs/api/

# Node and frontend build artifacts
node_modules/
.next/
out/
dashboard/frontend/.next/
dashboard/frontend/out/
dashboard/frontend/node_modules/
*.tsbuildinfo
next-env.d.ts

# Logs and runtime traces
logs/
*.log
.gstack/

# Archives and presentation source decks
*.zip
*.tar.gz
*.tgz
*.pptx

# LaTeX build artefacts (the manuscript source itself IS tracked in Paper/)
*.aux
*.bbl
*.blg
*.synctex.gz
*.out
*.toc
*.fls
*.fdb_latexmk
*.nav
*.snm
*.vrb
/Paper/AAAI
